;; controlled vocabulary for tools/llm2mars.py
(defpredicate ptrans :arity 3 :kind relation)
(defpredicate atrans :arity 3 :kind relation)
(defpredicate mtrans :arity 3 :kind relation)
(defpredicate mbuild :arity 2 :kind relation)
(defpredicate propel :arity 2 :kind relation)
(defpredicate ingest :arity 2 :kind relation)
(defpredicate expel :arity 2 :kind relation)
(defpredicate grasp :arity 2 :kind relation)
(defpredicate attend :arity 2 :kind relation)
(defpredicate create :arity 2 :kind relation)
(defpredicate destroy :arity 2 :kind relation)
(defpredicate increase :arity 1 :kind relation)
(defpredicate decrease :arity 1 :kind relation)
(defpredicate become :arity 2 :kind relation)
(defpredicate has-property :arity 2 :kind relation)
(defpredicate contain :arity 2 :kind relation)
(defpredicate part-of :arity 2 :kind relation)
(defpredicate at :arity 2 :kind relation)
(defpredicate support :arity 2 :kind relation)
(defpredicate block :arity 2 :kind relation)
(defpredicate attach :arity 2 :kind relation)
(defpredicate separate :arity 2 :kind relation)
(defpredicate want :arity 2 :kind relation)
(defpredicate try :arity 2 :kind relation)
(defpredicate succeed :arity 2 :kind relation)
(defpredicate fail :arity 2 :kind relation)
(defpredicate help :arity 2 :kind relation)
(defpredicate harm :arity 2 :kind relation)
(defpredicate compete :arity 2 :kind relation)
(defpredicate use :arity 3 :kind relation)
(defpredicate start :arity 1 :kind relation)
(defpredicate stop :arity 1 :kind relation)
